# ==============================================================================
# ENVIRONMENT & RUNTIME
# ==============================================================================
ENVIRONMENT=production
PROJECT_NAME="Timechamp Production Engine"
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
ALLOWED_HOSTS=["*"]

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS_COUNT=2

# ==============================================================================
# CLICKHOUSE DATABASE
# ==============================================================================
CLICKHOUSE_HOST=103.114.153.155
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=BI
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_DB=COMMAND_CENTER
CLICKHOUSE_SECURE=false
RUN_MIGRATIONS=false

# ==============================================================================
# REDIS (CELERY BROKER, CACHE & EVENT STREAMS)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_HOST=6380
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_STREAM_EVENTS=timechamp:events:stream
REDIS_STREAM_GROUP=timechamp-consumer-group


# ==============================================================================
# TIMECHAMP EXTERNAL API CREDENTIALS
# ==============================================================================
TIMECHAMP_API_BASE_URL=https://wyzmindz7570.v5.timechamp.io
TIMECHAMP_USERNAME=command-center@autosherpas.com
TIMECHAMP_PASSWORD=your_timechamp_api_password
TIMECHAMP_SYNC_INTERVAL_MINUTES=15
